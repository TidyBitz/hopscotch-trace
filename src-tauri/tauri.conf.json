{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopscotch",
  "version": "0.1.0",
  "identifier": "dev.hopscotch.trace",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hopscotch",
        "label": "main",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A visual traceroute",
    "longDescription": "Hopscotch traces the route your packets take to any host, draws it on a real world map, keeps probing so you can see drops as they happen, and remembers every run so you can compare them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
